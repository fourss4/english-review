{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "BackupManifest",
  "type": "object",
  "required": ["format", "schemaVersion", "createdAt", "files"],
  "properties": {
    "format": { "const": "english-review-backup" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "appVersion": { "type": "string" },
    "counts": {
      "type": "object",
      "properties": {
        "lessons": { "type": "integer", "minimum": 0 },
        "cards": { "type": "integer", "minimum": 0 },
        "generated": { "type": "integer", "minimum": 0 }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9._/-]+$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "additionalProperties": true
}
