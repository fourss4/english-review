{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weekly.schema.json",
  "title": "Weekly summary",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "from",
    "to",
    "lessonIds",
    "highlightsKo"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^wk_[0-9]{4}W[0-9]{2}$"
    },
    "from": {
      "type": "string",
      "format": "date"
    },
    "to": {
      "type": "string",
      "format": "date"
    },
    "lessonIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "highlightsKo": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topExpressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "meaningKo": {
            "type": "string"
          },
          "lessonId": {
            "type": "string"
          }
        }
      }
    },
    "repeatedMistakes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "patternKo"
        ],
        "properties": {
          "patternKo": {
            "type": "string"
          },
          "tipKo": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "original": {
                  "type": "string"
                },
                "corrected": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "focusNextWeekKo": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generator": {
      "type": "object"
    }
  }
}