{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson.schema.json",
  "title": "Lesson v2 (수업 처리기 결과, ADR 0006)",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "date",
    "corrections",
    "expressions",
    "upgrades",
    "exercises",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^les_[A-Za-z0-9_]+$"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "course": {
      "type": "string"
    },
    "lessonNo": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "durationSec": {
      "type": "number",
      "minimum": 0
    },
    "audio": {
      "type": "object",
      "required": [
        "file",
        "mimeType"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "mimeType": {
          "type": "string"
        },
        "durationSec": {
          "type": "number"
        },
        "originalFileName": {
          "type": "string"
        }
      }
    },
    "transcript": {
      "type": "object",
      "required": [
        "segments"
      ],
      "properties": {
        "generator": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "end",
              "text"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "original",
          "corrected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cor_[0-9]+$"
          },
          "original": {
            "type": "string",
            "minLength": 1
          },
          "corrected": {
            "type": "string",
            "minLength": 1
          },
          "natural": {
            "type": "string"
          },
          "explanationKo": {
            "type": "string"
          },
          "meaningKo": {
            "type": "string"
          },
          "source": {
            "enum": [
              "chat",
              "comment",
              "transcript",
              "manual"
            ]
          },
          "offsetSec": {
            "type": "number",
            "minimum": 0
          },
          "ai": {
            "type": "object",
            "description": "AI가 대신 만든 칸 표시",
            "properties": {
              "corrected": {
                "type": "boolean"
              },
              "natural": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "expressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^exp_[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "isKey": {
            "type": "boolean"
          },
          "pattern": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "meaningKo": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": [
                "en"
              ],
              "properties": {
                "en": {
                  "type": "string"
                },
                "ko": {
                  "type": "string"
                },
                "speaker": {
                  "type": "string"
                }
              }
            }
          },
          "source": {
            "enum": [
              "chat",
              "comment",
              "transcript",
              "manual"
            ]
          }
        }
      }
    },
    "upgrades": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "original",
          "suggestion",
          "category",
          "meaningKo",
          "explanationKo",
          "examples"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^up_[0-9]+$"
          },
          "original": {
            "type": "string"
          },
          "offsetSec": {
            "type": "number",
            "minimum": 0
          },
          "suggestion": {
            "type": "string"
          },
          "category": {
            "enum": [
              "slang",
              "idiom",
              "better_expression"
            ]
          },
          "register": {
            "enum": [
              "casual",
              "neutral",
              "formal"
            ]
          },
          "meaningKo": {
            "type": "string"
          },
          "explanationKo": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": [
                "en"
              ],
              "properties": {
                "en": {
                  "type": "string"
                },
                "ko": {
                  "type": "string"
                },
                "speaker": {
                  "type": "string"
                }
              }
            }
          },
          "situationKo": {
            "type": "string"
          },
          "opicQuestion": {
            "type": "string"
          }
        }
      }
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ref",
          "type",
          "prompt",
          "answer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ex_[A-Za-z0-9_]+$"
          },
          "ref": {
            "type": "string",
            "pattern": "^(cor|exp|up)_[0-9]+$"
          },
          "type": {
            "enum": [
              "cloze",
              "choice",
              "meaning",
              "situation"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "promptKo": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "accept": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "explanationKo": {
            "type": "string"
          }
        }
      }
    },
    "prep": {
      "type": "object",
      "description": "다음 수업 준비 노트",
      "properties": {
        "expressions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "howToUseKo": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "opic": {
      "type": "array",
      "description": "OPIc 모의 답변 연습",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^opic_[0-9]+$"
          },
          "question": {
            "type": "string"
          },
          "questionKo": {
            "type": "string"
          },
          "structureKo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "targetRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seconds": {
            "type": "integer",
            "minimum": 30,
            "maximum": 180
          }
        }
      }
    },
    "hidden": {
      "type": "array",
      "description": "사용자가 숨긴 항목 ID(복습 제외)",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "app",
        "importedAt"
      ],
      "properties": {
        "app": {
          "type": "string"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "stt": {
              "type": "string"
            },
            "llm": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                }
              }
            }
          }
        },
        "raw": {
          "type": "object",
          "properties": {
            "chat": {
              "type": "string"
            },
            "comment": {
              "type": "string"
            }
          }
        },
        "parserVersion": {
          "type": "string"
        },
        "migratedFrom": {
          "type": "integer"
        }
      }
    },
    "deletedAt": {
      "type": "string"
    }
  },
  "additionalProperties": true
}